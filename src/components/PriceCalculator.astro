---
import iller from '../data/il-mesafe.json';
import { CONTACT, PRICING } from '../config/site';
import { tl } from '../lib/price';

const sirali = [...iller].sort((a, b) => a.il.localeCompare(b.il, 'tr'));
const maxKm = Math.max(...iller.map((r) => r.km));
---

<div class="calc glow" data-wa={CONTACT.WHATSAPP} data-max={maxKm}>
  <div class="calc__in">
    <span class="label">Tarama yapılacak il</span>
    <div class="select">
      <select id="il" name="il" aria-label="Tarama yapılacak il">
        {sirali.map((r) => (
          <option value={r.il} selected={r.il === 'İstanbul'}>{r.il}</option>
        ))}
      </select>
      <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
    </div>

    <div class="route">
      <div class="route__ends" aria-hidden="true"><span>Mecidiyeköy</span><span id="hedef">İstanbul</span></div>
      <div class="route__rail">
        <i class="route__fill"></i><i class="route__dot"></i>
        <input id="kmRange" class="route__input" type="range" min="0" max={maxKm} step="1" value="0" aria-label="Mesafeye göre il seç (sürükle)" />
      </div>
      <div class="route__ends route__ends--dim" aria-hidden="true"><span>0 km</span><span>{maxKm} km</span></div>
    </div>

    <ul class="rows">
      <li><span>Mesafe</span><b id="km">Şehir içi</b></li>
      <li><span>Hesaplama</span><b id="formul">Sabit ücret</b></li>
      <li><span>Ulaşım</span><b>Dahil</b></li>
    </ul>
  </div>

  <div class="calc__out" aria-live="polite">
    <span class="label">Tarama ücreti</span>
    <output id="ucret" for="il" class="price">{tl(PRICING.BASE)}</output>
    <span class="per">Tarama başı · gizli ücret yok</span>
    <div class="actions">
      <a id="wa" class="btn btn--white" href="#" target="_blank" rel="noopener">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.8s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.6-.1l.9-1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.2Z"/></svg>
        WhatsApp'tan randevu al
      </a>
      <a class="btn btn--ghost" href={`tel:${CONTACT.PHONE_TEL}`}>Ara: {CONTACT.PHONE_DISPLAY}</a>
    </div>
  </div>
</div>

<script>
  import iller from '../data/il-mesafe.json';
  import { PRICING } from '../config/site';
  import { fiyatHesapla, tl } from '../lib/price';

  const root = document.querySelector<HTMLElement>('.calc')!;
  const sel = root.querySelector<HTMLSelectElement>('#il')!;
  const kmEl = root.querySelector('#km')!;
  const formulEl = root.querySelector('#formul')!;
  const fiyatEl = root.querySelector('#ucret')!;
  const hedefEl = root.querySelector('#hedef')!;
  const wa = root.querySelector<HTMLAnchorElement>('#wa')!;
  const range = root.querySelector<HTMLInputElement>('#kmRange')!;
  const maxKm = Number(root.dataset.max);
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const num = (n: number) => new Intl.NumberFormat('tr-TR').format(n);
  let anim = 0;
  let shown = PRICING.BASE;

  function sayac(hedef: number) {
    cancelAnimationFrame(anim);
    const bas = shown;
    if (reduce) { shown = hedef; fiyatEl.textContent = tl(hedef); return; }
    const t0 = performance.now();
    const tick = (t: number) => {
      const k = Math.min(1, (t - t0) / 650);
      const e = 1 - Math.pow(1 - k, 3);
      shown = k === 1 ? hedef : Math.round((bas + (hedef - bas) * e) / 100) * 100;
      fiyatEl.textContent = tl(shown);
      if (k < 1) anim = requestAnimationFrame(tick);
    };
    anim = requestAnimationFrame(tick);
  }

  function guncelle() {
    const kayit = iller.find((r) => r.il === sel.value) ?? { il: 'İstanbul', km: 0 };
    const fiyat = fiyatHesapla(kayit.km);
    const tavan = kayit.km > 0 && fiyat === PRICING.CAP;

    kmEl.textContent = kayit.km ? `≈ ${num(kayit.km)} km` : 'Şehir içi';
    formulEl.textContent = !kayit.km ? 'Sabit ücret' : tavan ? 'Üst sınır' : `${num(PRICING.BASE)} + ${num(kayit.km)} × ${PRICING.PER_KM}`;
    hedefEl.textContent = kayit.il;
    if (!root.classList.contains('dragging')) root.style.setProperty('--p', String(kayit.km / maxKm));
    if (!root.classList.contains('dragging')) range.value = String(kayit.km);
    range.setAttribute('aria-valuetext', `${kayit.il}, ${kayit.km ? num(kayit.km) + ' km' : 'şehir içi'}, ${tl(fiyat)}`);
    sayac(fiyat);

    const mesaj = `Merhaba, ${kayit.il} için yer altı tarama randevusu almak istiyorum.\nMesafe: ${kayit.km ? `≈ ${num(kayit.km)} km` : 'İstanbul içi'}\nSitede görünen ücret: ${tl(fiyat)}\nKonum (ilçe/köy): \nTercih ettiğim tarih: `;
    wa.href = `https://wa.me/${root.dataset.wa}?text=${encodeURIComponent(mesaj)}`;
  }

  // Kaydırıcı: sürükledikçe en yakın ile kilitlenir
  function enYakin(km: number) {
    let best = iller[0];
    for (const r of iller) if (Math.abs(r.km - km) < Math.abs(best.km - km)) best = r;
    return best;
  }
  range.addEventListener('input', () => {
    root.classList.add('dragging');
    const r = enYakin(Number(range.value));
    root.style.setProperty('--p', String(Number(range.value) / maxKm));
    if (sel.value !== r.il) { sel.value = r.il; guncelle(); }
  });
  range.addEventListener('change', () => {
    root.classList.remove('dragging');
    guncelle(); // il km'sine oturt
  });

  sel.addEventListener('change', guncelle);
  guncelle();
</script>

<style>
  .calc {
    --p: 0;
    display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    border: 1px solid var(--border); border-radius: 28px; overflow: hidden;
    background: linear-gradient(160deg, rgba(255,255,255,.05), rgba(255,255,255,.015));
    backdrop-filter: blur(20px);
  }
  .calc__in, .calc__out { padding: clamp(24px, 4vw, 44px); min-width: 0; }
  .calc__out {
    display: flex; flex-direction: column;
    border-left: 1px solid var(--border);
    background: radial-gradient(120% 100% at 100% 0%, rgba(79,209,197,.14), transparent 55%), radial-gradient(90% 90% at 0% 100%, rgba(108,140,255,.12), transparent 60%);
  }
  .label { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--text-dim); }

  .select { position: relative; margin-top: 12px; }
  select {
    appearance: none; width: 100%;
    font: 600 1.3rem/1 var(--font); letter-spacing: -.01em; color: var(--text);
    background: rgba(255,255,255,.04); border: 1px solid var(--border-strong); border-radius: 16px;
    padding: 18px 50px 18px 20px; cursor: pointer; transition: border-color .2s, background .2s;
  }
  select:hover { border-color: rgba(255,255,255,.3); background: rgba(255,255,255,.06); }
  select:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  option { background: var(--bg-elevated); color: var(--text); }
  .select svg { position: absolute; right: 18px; top: 50%; width: 16px; translate: 0 -50%; color: var(--text-muted); pointer-events: none; }

  .route { margin: 30px 0 26px; }
  .route__ends { display: flex; justify-content: space-between; font-size: 13px; font-weight: 600; }
  .route__input { position: absolute; left: -10px; right: -10px; top: 50%; width: calc(100% + 20px); height: 36px; translate: 0 -50%; margin: 0; opacity: 0; cursor: grab; touch-action: none; }
  .route__input:active { cursor: grabbing; }
  .route__input:focus-visible ~ .route__dot, .route__rail:has(.route__input:focus-visible) .route__dot { outline: 2px solid var(--accent); outline-offset: 4px; }
  .route__rail:hover .route__dot { transform: scale(1.2); }
  .dragging .route__fill, .dragging .route__dot { transition: none; }
  .route__ends--dim { font-size: 12px; font-weight: 500; color: var(--text-dim); }
  .route__rail { position: relative; height: 6px; margin: 16px 0; border-radius: 99px; background: rgba(255,255,255,.07); }
  .route__fill { position: absolute; inset: 0 auto 0 0; width: calc(var(--p) * 100%); border-radius: inherit; background: linear-gradient(90deg, var(--accent), var(--accent-2)); transition: width .7s cubic-bezier(.2,.8,.2,1); }
  .route__dot { position: absolute; top: 50%; left: calc(var(--p) * 100%); width: 16px; height: 16px; translate: -50% -50%; border-radius: 50%; background: #fff; box-shadow: 0 0 0 5px rgba(79,209,197,.25), 0 0 24px rgba(79,209,197,.6); transition: left .7s cubic-bezier(.2,.8,.2,1), transform .2s; }

  .rows { list-style: none; margin: 0; padding: 0; }
  .rows li { display: flex; justify-content: space-between; gap: 16px; padding: 13px 0; border-top: 1px solid var(--border); font-size: 15px; }
  .rows span { color: var(--text-muted); }
  .rows b { font-weight: 600; font-variant-numeric: tabular-nums; text-align: right; }

  .price {
    display: block; margin-top: 12px;
    font-size: clamp(48px, 6.4vw, 80px); font-weight: 700; letter-spacing: -.04em; line-height: 1;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .per { margin-top: 10px; color: var(--text-muted); font-size: 15px; }
  .actions { display: grid; gap: 10px; margin-top: auto; padding-top: 32px; }
  .actions svg { width: 18px; height: 18px; }

  @media (max-width: 860px) {
    .calc { grid-template-columns: minmax(0, 1fr); }
    .calc__out { border-left: 0; border-top: 1px solid var(--border); }
  }
</style>
