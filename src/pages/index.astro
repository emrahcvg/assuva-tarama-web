  .bg__glow--b { width: 520px; height: 820px; left: 30%; top: -200px; background: rgba(108,140,255,.16); animation: drift 24s ease-in-out infinite alternate-reverse; }
  .bg__glow--c { width: 420px; height: 420px; left: -160px; bottom: -120px; background: rgba(108,140,255,.2); animation: drift 20s ease-in-out infinite alternate; }
  @keyframes drift { to { transform: translate(60px, 40px) scale(1.1); } }
  .bg__words span {
    position: absolute; left: var(--x); top: calc(var(--i) * 26vh + 6vh);
    font-size: clamp(80px, 12vw, 180px); font-weight: 800; letter-spacing: -.05em; white-space: nowrap;
    color: rgba(255,255,255,.035); will-change: transform;
