  .cell--big { grid-column: span 2; grid-row: span 2; justify-content: space-between; background: radial-gradient(100% 70% at 0% 0%, rgba(79,209,197,.14), transparent 60%), linear-gradient(160deg, rgba(255,255,255,.05), rgba(255,255,255,.012)); }
  .cell--wide { grid-column: span 2; }
  .bignum { font-size: clamp(64px, 9vw, 120px); font-weight: 800; letter-spacing: -.05em; line-height: 1; background: linear-gradient(135deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .cell h3 { margin: auto 0 8px; padding-top: 28px; font-size: 20px; font-weight: 650; letter-spacing: -.02em; }
