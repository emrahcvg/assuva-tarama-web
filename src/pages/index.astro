  .bento { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); grid-auto-rows: minmax(220px, auto); gap: 18px; }
  .cell { grid-column: span 2; display: flex; flex-direction: column; padding: 28px; border-radius: 24px; background: linear-gradient(160deg, rgba(255,255,255,.04), rgba(255,255,255,.012)); border: 1px solid var(--border); backdrop-filter: blur(20px); overflow: hidden; transition: transform .25s ease, border-color .25s ease; }
