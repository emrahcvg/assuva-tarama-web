---
import PriceCalculator from '../components/PriceCalculator.astro';
import iller from '../data/il-mesafe.json';
import { CONTACT, PRICING } from '../config/site';
import { tl } from '../lib/price';

const DEVICE = 'Proton Elic LB4S';
const title = `${DEVICE} ile Yer Altı Tarama Hizmeti — ${CONTACT.BRAND}`;
const description = `${DEVICE} ve Norton 3D yazılımıyla kazı yapmadan yer altı boşluk ve metal anomali taraması. Mecidiyeköy merkezli, Türkiye'nin her iline geliyoruz. İstanbul içi ${tl(PRICING.BASE)}. Tel: ${CONTACT.PHONE_DISPLAY}`;
const waHref = `https://wa.me/${CONTACT.WHATSAPP}?text=${encodeURIComponent('Merhaba, yer altı tarama hizmeti hakkında bilgi almak istiyorum.')}`;

// Arka planda süzülen dev il isimleri
const bgWords = ['İstanbul', 'Ankara', 'Trabzon', 'Antalya', 'Erzurum', 'İzmir', 'Konya', 'Diyarbakır', 'Samsun', 'Van', 'Bursa', 'Hakkari'];
const marquee = [...iller].sort((a, b) => a.km - b.km).map((r) => r.il);

const sensorler = [
  { kod: 'THM', ad: '64 piksel termal sensör', is: '4×16 matris, 60° görüş açısı. Sıcaklık farklarından tünel, oda ve boşlukları ayırt eder.' },
  { kod: 'MAG', ad: '4 sezyum manyetik multi-sensör', is: 'Manyetik alanı (faz) 4 noktada aynı anda ölçer; hızlı veri, net metal ve boşluk izi.' },
  { kod: 'LDR', ad: 'LiDAR + lazer işaretleme', is: 'Zemin yüzeyini tanır, lazerle hedefin tam noktasını gösterir.' },
  { kod: '3D', ad: 'Norton 3D görüntüleme yazılımı', is: 'Bluetooth ile bilgisayara aktarılır; metal kırmızı, boşluk mavi, zemin yeşil 3D görüntü.' },
];

const galeri = [
  { f: 'saha', t: 'Sahada tarama', alt: 'Temsili çizim: sensör kolu yüzeyden tarıyor, yer altında boşluk ve metal anomalisi işaretli' },
  { f: 'sensor', t: 'Sensör modülü', alt: 'Temsili çizim: 4×16 termal matris, dört manyetik sensör, LiDAR ve Bluetooth bağlantısı' },
  { f: 'goruntu', t: '3D görüntü', alt: 'Temsili çizim: 3D zemin haritasında kırmızı metal tepesi ve mavi boşluk çukuru' },
];
const sss = [
  ['Bir tarama ne kadar sürer?', 'Alanın büyüklüğüne ve zemine göre değişir; tipik bir parsel taraması sahada 2–4 saat sürer. Kurulum ve ön değerlendirme bu süreye dahildir.'],
  ['Hangi cihazı kullanıyorsunuz?', 'Proton Elic LB4S: 64 piksel termal sensör, 4 sezyum manyetik multi-sensör ve LiDAR bir arada. Veriler Norton 3D yazılımıyla görüntülenir; metal, boşluk ve zemin farklı renklerle ayrılır.'],
  ['Cihaz ne kadar derine iner?', 'Algılama derinliği zemin yapısına, nem oranına ve hedefin boyutuna bağlıdır. Sahada önce zemin kalibrasyonu yapar, o alan için gerçekçi derinlik aralığını size açıkça söyleriz.'],
  ['Sonuçları nasıl alıyorum?', 'Tarama sırasında veriler Bluetooth ile bilgisayara aktarılır, Norton yazılımında 3D görüntüyü birlikte izlersiniz. Ardından tespit edilen anomali noktaları, koordinatları ve görüntüleriyle yazılı rapor teslim edilir.'],
  ['Ücrete neler dahil?', "Ekip, cihaz, Mecidiyeköy'den konumunuza gidiş-dönüş ve bir tarama oturumu. Hesaplayıcıdaki tutar dışında ek yol ücreti alınmaz."],
  ['Ödeme ve iptal nasıl?', 'Randevu kesinleşince kapora alınır, kalan tutar tarama günü ödenir. Yola çıkmadan 48 saat öncesine kadar yapılan iptallerde kapora iade edilir.'],
  ['Kazı da yapıyor musunuz?', 'Hayır. Yalnızca tahribatsız tarama ve görüntüleme hizmeti veriyoruz. Herhangi bir kazı, ilgili mevzuata ve resmi izinlere tabidir.'],
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Yer Altı Görüntüleme ve Tarama',
  serviceType: 'Yer altı boşluk ve metal anomali taraması',
  areaServed: { '@type': 'Country', name: 'Türkiye' },
  provider: {
    '@type': 'LocalBusiness',
    name: CONTACT.BRAND,
    telephone: CONTACT.PHONE_TEL,
    address: { '@type': 'PostalAddress', addressLocality: 'Şişli', addressRegion: 'İstanbul', addressCountry: 'TR', streetAddress: 'Mecidiyeköy' },
  },
  offers: { '@type': 'AggregateOffer', priceCurrency: 'TRY', lowPrice: PRICING.BASE, highPrice: PRICING.CAP },
};

const asset = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path}`;

const waIcon = 'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.8s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.6-.1l.9-1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.2Z';
const phoneIcon = 'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z';
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B0E1A" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <!-- Arka plan: gradyan ışıklar + süzülen il isimleri -->
    <div class="bg" aria-hidden="true">
      <div class="bg__glow bg__glow--a"></div>
      <div class="bg__glow bg__glow--b"></div>
      <div class="bg__glow bg__glow--c"></div>
      <div class="bg__words">
        {bgWords.map((w, i) => <span style={`--i:${i};--x:${((i * 37) % 70) - 6}%`}>{w}</span>)}
      </div>
    </div>

    <header class="nav">
      <div class="wrap nav__in">
        <a href="#" class="brand">
          <svg class="brand__logo" viewBox="0 0 32 32" aria-hidden="true"><defs><linearGradient id="lg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#4FD1C5"/><stop offset="1" stop-color="#6C8CFF"/></linearGradient></defs><circle cx="16" cy="16" r="13" fill="none" stroke="url(#lg)" stroke-width="2"/><circle cx="16" cy="16" r="7.5" fill="none" stroke="url(#lg)" stroke-width="1.5" opacity=".6"/><path d="M16 16 L27 9" stroke="#fff" stroke-width="2" stroke-linecap="round"/><circle cx="21" cy="20" r="2.2" fill="#4FD1C5"/></svg>
          {CONTACT.BRAND}
        </a>
        <nav class="nav__links" aria-label="Ana menü">
          <a href="#hizmet">Hizmet</a>
          <a href="#cihaz">Cihaz</a>
          <a href="#galeri">Galeri</a>
          <a href="#fiyat">Fiyat</a>
          <a href="#sss">SSS</a>
        </nav>
        <a class="btn btn--white btn--sm" href={`tel:${CONTACT.PHONE_TEL}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={phoneIcon} /></svg>
          {CONTACT.PHONE_DISPLAY}
        </a>
      </div>
    </header>

    <main>
      <!-- HERO -->
      <section class="hero wrap">
        <div class="hero__copy">
          <span class="pill"><span class="pill__dot"></span>Norton 3D yazılımlı · Mecidiyeköy · 81 il</span>
          <h1><span class="h1-device">{DEVICE}</span> ile toprağın altını <span class="grad">kazmadan</span> görün.</h1>
          <p class="sub">Termal, manyetik ve LiDAR sensörlü {DEVICE} ile arazinize geliyor; boşluk, tünel ve metal anomalilerini yerinde tarayıp aynı gün raporluyoruz.</p>
          <div class="cta">
            <a class="btn btn--white" href="#fiyat">Fiyatını hesapla</a>
            <a class="btn btn--ghost" href={waHref} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={waIcon} /></svg>
              WhatsApp'tan yaz
            </a>
          </div>
          <ul class="checks">
            <li>Kazı yok, tahribat yok — tamamen yüzeyden tarama</li>
            <li>İstanbul içi sabit {tl(PRICING.BASE)}, ulaşım dahil</li>
            <li>Norton yazılımında 3D görüntüyü sahada birlikte izleyin</li>
          </ul>
        </div>

        <div class="device">
          <figure class="photo">
            <img src={asset('img/cizim/saha.svg')} width="900" height="1200" alt="Temsili çizim: yer altı tarama cihazı yüzeyden tarıyor, tarama dalgaları boşluk ve metal anomalisini işaretliyor" fetchpriority="high" />
            <figcaption><span class="pill__dot"></span>{DEVICE} · Norton</figcaption>
          </figure>
          <div class="scan-card">
            <div class="device__top">
              <span class="label">Norton · canlı tarama</span>
              <span class="live"><i></i>Aktif</span>
            </div>
            <div class="radar">
              <canvas id="radar" role="img" aria-label="Animasyonlu yer altı tarama görüntüsü"></canvas>
            </div>
            <div class="device__legend">
              <span><i class="sw sw--metal"></i>Metal</span>
              <span><i class="sw sw--void"></i>Boşluk</span>
              <span><i class="sw sw--soil"></i>Zemin</span>
            </div>
          </div>
          <div class="float float--a"><span class="label">Tespit</span><b id="cnt">0</b><small>anomali</small></div>
          <div class="float float--b"><span class="label">Termal</span><b>64 px</b><small>4×16 matris</small></div>
        </div>
      </section>

      <!-- MARQUEE: il isimleri -->
      <section class="marquee-section" aria-label="Hizmet verilen iller">
        <div class="marquee">
          {[0, 1].map((k) => (
            <div class="marquee__track" aria-hidden={k === 1 ? 'true' : undefined}>
              {marquee.map((il) => <span>{il}</span>)}
            </div>
          ))}
        </div>
      </section>

      <!-- BENTO: hizmet -->
      <section id="hizmet" class="section wrap">
        <div class="head">
          <span class="label">Hizmet</span>
          <h2>Ne arıyorsanız, önce <span class="grad">görün</span>.</h2>
          <p>Toprağı kazmadan önce altında ne olduğunu bilin. Zaman, para ve emek kaybını baştan önleyin.</p>
        </div>
        <div class="bento">
          <article class="cell cell--big glow">
            <span class="label">Kapsama</span>
            <span class="bignum">81 il</span>
            <p>Mecidiyeköy'den çıkıyor, Edirne'den Hakkari'ye Türkiye'nin her noktasına geliyoruz.</p>
          </article>
          <article class="cell glow">
            <div class="icon"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="12" rx="9" ry="5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-dasharray="3 3"/></svg></div>
            <h3>Boşluk ve tünel tespiti</h3>
            <p>Termal ve manyetik veriyi birleştirerek oda, galeri, tünel ve dolgu farklılıklarını işaretleriz.</p>
          </article>
          <article class="cell glow">
            <div class="icon"><svg viewBox="0 0 24 24"><rect x="7" y="7" width="10" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></div>
            <h3>Metal anomali taraması</h3>
            <p>Demirli ve demirsiz metal kütlelerini konum ve yoğunluk olarak ayırt eder, koordinatlı raporlarız.</p>
          </article>
          <article class="cell glow">
            <div class="icon"><svg viewBox="0 0 24 24"><path d="M3 20h18M5 20V9l7-5 7 5v11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></div>
            <h3>Yapı ve zemin kontrolü</h3>
            <p>İnşaat öncesi parsel, eski temel, kuyu ve altyapı hattı gibi gizli unsurları önceden görün.</p>
          </article>
          <article class="cell cell--wide cell--photo glow">
            <img src={asset('img/cizim/goruntu.svg')} width="384" height="512" alt="" loading="lazy" />
            <span class="label">Rapor</span>
            <h3>3D görüntü, aynı gün rapor</h3>
            <p>Norton yazılımında 3D görüntüyü birlikte izlersiniz. Anomali noktaları koordinatları ve görüntüleriyle raporlanır.</p>
            <div class="bars" aria-hidden="true">{Array.from({ length: 18 }, (_, i) => <i style={`--h:${20 + Math.round(Math.abs(Math.sin(i * 1.7)) * 70)}%;--d:${i * 60}ms`}></i>)}</div>
          </article>
        </div>
      </section>

      <!-- CİHAZ -->
      <section id="cihaz" class="section wrap">
        <div class="head">
          <span class="label">Ekipman</span>
          <h2><span class="grad">Proton Elic LB4S</span></h2>
          <span class="pill model-pill"><span class="pill__dot"></span>Norton 3D yazılımlı</span>
          <p>Termal, manyetik ve LiDAR sensörlerini tek gövdede toplayan, verileri Bluetooth ile Norton 3D yazılımına aktaran yer altı görüntüleme sistemi. Sahaya bu cihazla geliyoruz.</p>
        </div>
        <div class="split">
          <div class="collage">
            <figure class="collage__main glow">
              <img src={asset('img/cizim/sensor.svg')} width="900" height="1200" alt="Temsili çizim: termal matris, manyetik sensörler ve LiDAR'ı bir arada gösteren sensör modülü" loading="lazy" />
            </figure>
            <figure class="collage__side">
              <img src={asset('img/cizim/saha.svg')} width="384" height="512" alt="Temsili çizim: sahada yüzeyden tarama" loading="lazy" />
              <figcaption>Sahada tarama</figcaption>
            </figure>
            <figure class="collage__side collage__side--b">
              <img src={asset('img/cizim/goruntu.svg')} width="384" height="512" alt="Temsili çizim: 3D görüntüde metal ve boşluk" loading="lazy" />
              <figcaption>Bluetooth → 3D görüntü</figcaption>
            </figure>
          </div>
          <div>
            <ul class="sensors">
              {sensorler.map((s) => (
                <li class="glow">
                  <span class="tag">{s.kod}</span>
                  <div><h3>{s.ad}</h3><p>{s.is}</p></div>
                </li>
              ))}
            </ul>
            <p class="note">Algılama derinliği zemin yapısı, nem ve hedef boyutuna göre değişir. Her taramadan önce zemin kalibrasyonu yapılır.</p>
          </div>
        </div>
      </section>

      <!-- GALERİ -->
      <section id="galeri" class="section">
        <div class="head wrap">
          <span class="label">Galeri</span>
          <h2>Taramayı <span class="grad">adım adım</span> görün.</h2>
          <p>Sahadan 3D görüntüye tarama süreci, temsili çizimlerle. Büyütmek için dokunun.</p>
        </div>
        <div class="gallery" id="gallery">
          {galeri.map((g) => (
            <button class="gallery__item" type="button" data-full={asset(`img/cizim/${g.f}.svg`)} data-alt={g.alt}>
              <img src={asset(`img/cizim/${g.f}.svg`)} width="384" height="512" alt={g.alt} loading="lazy" />
              <span>{g.t}</span>
            </button>
          ))}
        </div>
        <dialog class="lightbox" id="lightbox" aria-label="Görsel görüntüleyici">
          <img id="lbImg" src="" alt="" />
          <button class="lightbox__close" type="button" aria-label="Kapat">✕</button>
        </dialog>
      </section>

      <!-- FİYAT -->
      <section id="fiyat" class="section wrap">
        <div class="head">
          <span class="label">Şeffaf fiyat</span>
          <h2>İlini seç, fiyatı <span class="grad">hemen</span> gör.</h2>
          <p>İstanbul içi sabit {tl(PRICING.BASE)}. Diğer illerde Mecidiyeköy'den karayolu mesafesine göre hesaplanır, en fazla {tl(PRICING.CAP)}.</p>
        </div>
        <PriceCalculator />
      </section>

      <!-- SÜREÇ -->
      <section class="section wrap">
        <div class="head">
          <span class="label">Nasıl çalışır</span>
          <h2>Üç adımda <span class="grad">sahadayız</span>.</h2>
        </div>
        <ol class="steps">
          <li class="glow"><span class="step-n">1</span><h3>Fiyatını gör</h3><p>Hesaplayıcıdan ilini seç, ücreti anında öğren.</p></li>
          <li class="glow"><span class="step-n">2</span><h3>WhatsApp'tan yaz</h3><p>Konum ve tarih bilgisini paylaş, randevunu kesinleştirelim.</p></li>
          <li class="glow"><span class="step-n">3</span><h3>Ekip konumuna gelsin</h3><p>Taramayı birlikte izle, raporunu aynı gün al.</p></li>
        </ol>
      </section>

      <!-- SSS -->
      <section id="sss" class="section wrap faq">
        <div class="head head--left">
          <span class="label">SSS</span>
          <h2>Sık sorulanlar</h2>
          <p>Aradığınız cevap yoksa <a href={`tel:${CONTACT.PHONE_TEL}`}>{CONTACT.PHONE_DISPLAY}</a> numarasından bize ulaşın.</p>
        </div>
        <div class="faq__list">
          {sss.map(([q, a]) => (
            <details>
              <summary>{q}<span class="chev" aria-hidden="true"></span></summary>
              <p>{a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- CTA -->
      <section class="section wrap">
        <div class="final glow">
          <span class="pill"><span class="pill__dot"></span>7/24 WhatsApp</span>
          <h2>Arazinizin altında <span class="grad">ne var</span>?</h2>
          <p>Hemen arayın ya da yazın, uygun tarihe randevunuzu oluşturalım.</p>
          <div class="cta cta--center">
            <a class="btn btn--white" href={`tel:${CONTACT.PHONE_TEL}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={phoneIcon} /></svg>
              {CONTACT.PHONE_DISPLAY}
            </a>
            <a class="btn btn--ghost" href={waHref} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={waIcon} /></svg>
              WhatsApp'tan yaz
            </a>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer wrap">
      <div class="footer__top">
        <div>
          <a href="#" class="brand">{CONTACT.BRAND}</a>
          <p>{CONTACT.ADDRESS}</p>
          <p><a href={`tel:${CONTACT.PHONE_TEL}`}>{CONTACT.PHONE_DISPLAY}</a> · <a href={waHref} target="_blank" rel="noopener">WhatsApp</a></p>
        </div>
        <p class="legal">Yalnızca tahribatsız tarama ve görüntüleme hizmeti verilir; kazı yapılmaz ve teşvik edilmez. 2863 sayılı Kültür ve Tabiat Varlıklarını Koruma Kanunu kapsamındaki alanlarda izinsiz arama ve kazı suçtur. Tarama sonuçları teknik yorumdur, kesin sonuç garantisi verilmez. Fiyatlar tarama başıdır; mesafeler il merkezine yaklaşık karayolu değeridir.</p>
      </div>
      <p class="copy">© {new Date().getFullYear()} {CONTACT.BRAND}. Tüm hakları saklıdır.</p>
    </footer>

    <div class="cursor" aria-hidden="true"><i class="cursor__ring"></i><i class="cursor__dot"></i></div>

    <a class="fab" href={waHref} target="_blank" rel="noopener" aria-label="WhatsApp'tan yaz">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={waIcon} /></svg>
    </a>

    <script>
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Kartlarda fareyi takip eden parlama
      document.querySelectorAll<HTMLElement>('.glow').forEach((el) => {
        el.addEventListener('pointermove', (e) => {
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', `${e.clientX - r.left}px`);
          el.style.setProperty('--my', `${e.clientY - r.top}px`);
        });
      });

      // Arka plan kelimeleri scroll ile yatay kayar
      const words = [...document.querySelectorAll<HTMLElement>('.bg__words span')];
      if (!reduce) {
        let ticking = false;
        const move = () => {
          const y = scrollY;
          words.forEach((w, i) => {
            const dir = i % 2 ? -1 : 1;
            w.style.transform = `translate3d(${dir * y * (0.08 + (i % 4) * 0.03)}px, ${-y * 0.25}px, 0)`;
          });
          ticking = false;
        };
        addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(move); } }, { passive: true });
        move();
      }

      // Scroll'da beliren öğeler
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12 });
      document.querySelectorAll('.head, .cell, .sensors li, .steps li, .calc, .final, .collage, .gallery').forEach((el) => { el.classList.add('reveal'); io.observe(el); });

      // Fareyi takip eden nokta + halka + arka plan ışığı
      if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
        const root = document.documentElement;
        const dot = document.querySelector<HTMLElement>('.cursor__dot')!;
        const ring = document.querySelector<HTMLElement>('.cursor__ring')!;
        let mx = innerWidth / 2, my = innerHeight / 2, rx = mx, ry = my;
        root.classList.add('has-cursor');
        addEventListener('pointermove', (e) => {
          mx = e.clientX; my = e.clientY;
          dot.style.transform = `translate3d(${mx}px, ${my}px, 0)`;
          root.style.setProperty('--gx', `${mx}px`);
          root.style.setProperty('--gy', `${my}px`);
          root.classList.add('cursor-on');
          const t = e.target as Element;
          root.classList.toggle('cursor-hover', !!t.closest('a, button, select, summary, .glow, .gallery__item'));
        }, { passive: true });
        document.addEventListener('pointerleave', () => root.classList.remove('cursor-on'));
        addEventListener('pointerdown', () => root.classList.add('cursor-down'));
        addEventListener('pointerup', () => root.classList.remove('cursor-down'));
        const follow = () => {
          const k = reduce ? 1 : 0.16;
          rx += (mx - rx) * k; ry += (my - ry) * k;
          ring.style.transform = `translate3d(${rx}px, ${ry}px, 0)`;
          requestAnimationFrame(follow);
        };
        follow();
      }

      // Galeri büyütme
      const lb = document.getElementById('lightbox') as HTMLDialogElement;
      const lbImg = document.getElementById('lbImg') as HTMLImageElement;
      document.querySelectorAll<HTMLButtonElement>('.gallery__item').forEach((b) => b.addEventListener('click', () => {
        lbImg.src = b.dataset.full!; lbImg.alt = b.dataset.alt!; lb.showModal();
      }));
      lb.addEventListener('click', () => lb.close());

      // Radar
      const cv = document.getElementById('radar') as HTMLCanvasElement;
      const cnt = document.getElementById('cnt')!;
      const ctx = cv.getContext('2d')!;
      let W = 0, H = 0;
      const fit = () => {
        const r = cv.getBoundingClientRect(), d = Math.min(2, devicePixelRatio || 1);
        W = r.width; H = r.height; cv.width = W * d; cv.height = H * d; ctx.setTransform(d, 0, 0, d, 0, 0);
      };
      fit();
      addEventListener('resize', fit);

      type Blip = { a: number; r: number; t: 0 | 1 | 2; e: number };
      const blips: Blip[] = [
        { a: 0.5, r: 0.58, t: 0, e: 0 }, { a: 1.6, r: 0.34, t: 1, e: 0 }, { a: 2.5, r: 0.8, t: 2, e: 0 },
        { a: 3.4, r: 0.5, t: 0, e: 0 }, { a: 4.3, r: 0.7, t: 1, e: 0 }, { a: 5.4, r: 0.4, t: 0, e: 0 },
      ];
      const COL = ['#F87171', '#6C8CFF', '#10B981'];
      let ang = 0, prev = performance.now(), found = 0, visible = true;
      new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(cv);

      function draw(now: number) {
        const dt = Math.min(0.05, (now - prev) / 1000); prev = now;
        const cx = W / 2, cy = H / 2, R = Math.min(W, H) / 2 - 6;
        const last = ang; ang = (ang + dt * 1.05) % (Math.PI * 2);
        ctx.clearRect(0, 0, W, H);

        ctx.strokeStyle = 'rgba(255,255,255,.07)'; ctx.lineWidth = 1;
        for (let i = 1; i <= 4; i++) { ctx.beginPath(); ctx.arc(cx, cy, (R * i) / 4, 0, Math.PI * 2); ctx.stroke(); }
        ctx.beginPath(); ctx.moveTo(cx - R, cy); ctx.lineTo(cx + R, cy); ctx.moveTo(cx, cy - R); ctx.lineTo(cx, cy + R); ctx.stroke();

        // Süpürme konisi
        if ('createConicGradient' in ctx) {
          const g = ctx.createConicGradient(ang - 0.9, cx, cy);
          g.addColorStop(0, 'rgba(79,209,197,0)');
          g.addColorStop(0.143, 'rgba(79,209,197,.28)');
          g.addColorStop(0.1433, 'rgba(79,209,197,0)');
          ctx.fillStyle = g; ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI * 2); ctx.fill();
        }
        ctx.strokeStyle = 'rgba(79,209,197,.9)'; ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(cx + Math.cos(ang) * R, cy + Math.sin(ang) * R); ctx.stroke();

        for (const b of blips) {
          const hit = last <= ang ? b.a > last && b.a <= ang : b.a > last || b.a <= ang;
          if (hit) { b.e = 1; found++; cnt.textContent = String(found); }
          b.e = Math.max(0, b.e - dt * 0.32);
          if (!b.e) continue;
          const x = cx + Math.cos(b.a) * R * b.r, y = cy + Math.sin(b.a) * R * b.r;
          const rg = ctx.createRadialGradient(x, y, 0, x, y, 22);
          rg.addColorStop(0, COL[b.t]); rg.addColorStop(1, 'transparent');
          ctx.globalAlpha = b.e * 0.55; ctx.fillStyle = rg; ctx.beginPath(); ctx.arc(x, y, 22, 0, Math.PI * 2); ctx.fill();
          ctx.globalAlpha = b.e; ctx.fillStyle = COL[b.t]; ctx.beginPath(); ctx.arc(x, y, 4, 0, Math.PI * 2); ctx.fill();
          ctx.globalAlpha = 1;
        }
        ctx.fillStyle = '#fff'; ctx.beginPath(); ctx.arc(cx, cy, 3, 0, Math.PI * 2); ctx.fill();
      }
      function loop(t: number) { if (visible) draw(t); else prev = t; requestAnimationFrame(loop); }
      if (reduce) { blips.forEach((b) => (b.e = 1)); draw(performance.now() + 16); cnt.textContent = '6'; }
      else requestAnimationFrame(loop);
    </script>
  </body>
</html>

<style is:global>
  :root {
