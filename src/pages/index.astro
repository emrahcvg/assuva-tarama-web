  .head--left { text-align: left; margin: 0; }

  /* Kart + parlama */
  .glow { position: relative; }
  .glow::before { content: ''; position: absolute; inset: 0; border-radius: inherit; background: radial-gradient(500px circle at var(--mx, 50%) var(--my, 50%), rgba(79,209,197,.12), transparent 50%); opacity: 0; transition: opacity .3s; pointer-events: none; }
