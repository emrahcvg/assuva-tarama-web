  .marquee__track span { color: var(--text-muted); font-size: 19px; font-weight: 500; letter-spacing: -.01em; white-space: nowrap; transition: color .15s; }
  .marquee__track span:hover { color: var(--text); }
  @keyframes mq { to { transform: translateX(-100%); } }

  /* Bölüm */
  .section { padding: clamp(72px, 10vw, 120px) 0 0; }
  .head { text-align: center; max-width: 720px; margin: 0 auto 56px; }
  .head h2, .split h2 { margin: 14px 0 12px; font-size: clamp(32px, 4.8vw, 54px); font-weight: 700; letter-spacing: -.035em; line-height: 1.05; }
  .head p { margin: 0; color: var(--text-muted); font-size: 17px; }
