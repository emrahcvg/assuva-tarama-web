  .device { position: relative; perspective: 1400px; }
  .device__top { display: flex; justify-content: space-between; align-items: center; padding: 4px 6px 14px; }
  .live { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; color: var(--success); }
  .live i { width: 7px; height: 7px; border-radius: 50%; background: var(--success); animation: pulse 1.6s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: .3; } }
  .radar { aspect-ratio: 1; border-radius: 16px; background: radial-gradient(circle, rgba(79,209,197,.08), rgba(11,14,26,.9) 70%); border: 1px solid var(--border); overflow: hidden; }
  .radar canvas { width: 100%; height: 100%; display: block; }
  .device__legend { display: flex; justify-content: center; gap: 22px; padding-top: 16px; font-size: 13px; color: var(--text-muted); }
  .device__legend span { display: inline-flex; align-items: center; gap: 7px; }
  .sw { width: 9px; height: 9px; border-radius: 50%; }
  .sw--metal { background: #F87171; } .sw--void { background: var(--accent-2); } .sw--soil { background: var(--success); }
  .float { position: absolute; display: grid; padding: 14px 18px; border-radius: 18px; background: rgba(17,21,42,.75); border: 1px solid var(--border-strong); backdrop-filter: blur(18px); box-shadow: 0 20px 50px rgba(0,0,0,.4); animation: bob 6s ease-in-out infinite; }
  .float b { font-size: 28px; font-weight: 700; letter-spacing: -.03em; line-height: 1.1; margin-top: 4px; }
  .float small { color: var(--text-muted); font-size: 12px; }
  .float--a { left: -28px; bottom: 90px; }
  .float--b { right: -18px; top: 70px; animation-delay: -3s; }
  @keyframes bob { 50% { transform: translateY(-10px); } }


  /* Hero gerçek fotoğraf */
  .photo { position: relative; margin: 0 0 0 auto; width: 88%; border-radius: 32px; overflow: hidden; border: 1px solid var(--border-strong); box-shadow: 0 40px 120px rgba(0,0,0,.55), 0 0 0 1px rgba(255,255,255,.04); transform: rotateY(-6deg) rotateX(3deg); transition: transform .7s cubic-bezier(.2,.8,.2,1); }
  .device:hover .photo { transform: rotateY(-2deg) rotateX(1deg); }
  .photo img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; object-position: 50% 70%; }
  .photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(11,14,26,.55), transparent 25%, transparent 60%, rgba(11,14,26,.85)), linear-gradient(120deg, rgba(79,209,197,.12), transparent 40%); pointer-events: none; }
  .photo figcaption { position: absolute; left: 20px; top: 18px; z-index: 1; display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px; border-radius: 999px; font-size: 13px; font-weight: 600; background: rgba(11,14,26,.6); border: 1px solid var(--border-strong); backdrop-filter: blur(12px); }
  .scan-card { position: absolute; left: -36px; bottom: -36px; width: 46%; min-width: 210px; padding: 12px; border-radius: 22px; background: rgba(17,21,42,.78); border: 1px solid var(--border-strong); backdrop-filter: blur(20px); box-shadow: 0 30px 70px rgba(0,0,0,.5); z-index: 2; }
  .scan-card .device__top { padding: 2px 4px 10px; }
  .scan-card .device__legend { gap: 12px; padding-top: 10px; font-size: 11px; }
  .float--a { left: auto !important; right: -14px; bottom: 120px !important; }

  /* Bento: fotoğraflı hücre */
  .cell--photo { position: relative; }
  .cell--photo > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .28; transition: opacity .4s, transform .6s; z-index: 0; }
  .cell--photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(11,14,26,.2), rgba(11,14,26,.92)); z-index: 0; }
